# 复制本文件为 .env 后填入真实配置
# 数据库连接
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/lab_agent

# JWT 配置
JWT_SECRET_KEY=please-change-this-to-a-random-secret
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 大模型接口配置（兜底模型）
# AI 对话模块另有独立配置，见同目录 .env.ai.example，优先级更高
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name

# ===== AI 对话模型（优先级高于上面的 LLM_*；留空则回落到 LLM_*）=====
# 任何 OpenAI 兼容接口都行（OpenAI / 中转 / 本地 vLLM / Ollama）
AI_LLM_MODEL=
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
