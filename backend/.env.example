# 复制本文件为 .env 后填入真实配置
# 数据库连接
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/lab_agent

# JWT 配置
JWT_SECRET_KEY=please-change-this-to-a-random-secret
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 大模型接口配置（兜底模型）
# AI 对话模块另有独立配置，见同目录 .env.ai.example，优先级更高
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name

# ===== AI 对话模型（优先级高于上面的 LLM_*；留空则回落到 LLM_*）=====
# 任何 OpenAI 兼容接口都行（OpenAI / 中转 / 本地 vLLM / Ollama）
AI_LLM_MODEL=
AI_LLM_BASE_URL=
AI_LLM_API_KEY=

# ===== AI 用量限额（公网部署必配，防止被人刷爆 token）=====
# 口径：**按登录会话**计，不是按天 —— 重新登录 → 新 token（带新的 iat）→ 额度刷新。
# 实测：一次完整预约 = 3 轮对话 ≈ 12400 token（输入占大头，因为 system prompt + 工具 schema 每轮重发）
# 改成 0 表示该项不限；管理员（role=admin）恒不限
# 单次登录最多几轮对话
AI_SESSION_RUN_LIMIT=10
# 单次登录最多多少 token（25000 ≈ 2 次完整预约）
AI_SESSION_TOKEN_LIMIT=25000
# 日兜底（登录不清零，只防反复重登无限刷；设 0 关闭）
AI_DAILY_RUN_LIMIT=80
AI_DAILY_TOKEN_LIMIT=200000
# 单条消息最长多少字
AI_MAX_INPUT_CHARS=500
