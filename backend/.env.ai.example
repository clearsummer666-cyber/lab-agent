# AI 对话模块的独立模型配置
#
# 用法：复制本文件为 .env.ai，填入真实值。
#   cp .env.ai.example .env.ai
#
# 为什么要单独一个文件：
#   业务配置（.env）里的 LLM_* 是兜底模型，可能撞速率限制。
#   AI 对话模块用这里的 AI_LLM_*，优先级高于 .env 的 LLM_*。
#   app/ai/builder.py 用 load_dotenv(override=False) 读取 —— 已存在的环境变量优先。
#
# ★ 本文件会被提交，.env.ai 不会（.gitignore 已排除）。别把真 key 写在这里。
# ★ 改完必须重启服务才生效。

# 任何 OpenAI 兼容接口都行（OpenAI / 各家中转 / 本地 vLLM / Ollama）
AI_LLM_MODEL=your-model-name
AI_LLM_BASE_URL=https://api.example.com/v1
AI_LLM_API_KEY=sk-your-api-key
