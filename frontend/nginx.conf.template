# 由 nginx 官方镜像的 envsubst 机制渲染，${SERVER_NAME} 来自容器环境变量
upstream lab_backend {
    server backend:8000;
}

# ---------- HTTP：只负责证书挑战 + 全站跳 HTTPS ----------
server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt 的 webroot 校验路径，续期时走这里
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS：静态前端 + 反代后端 ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 后端限制单文件 100MB（config.py 里的 MAX_FILE_SIZE），Nginx 不能比它小
    client_max_body_size 100m;

    root  /usr/share/nginx/html;
    index index.html;

    # 前端是 vue-router history 模式：找不到的路径一律交回 index.html，
    # 否则刷新 /manager/home 会 404。
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 带 hash 的构建产物可以长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 后端 API
    location /api/ {
        proxy_pass http://lab_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ★ SSE 关键：不关缓冲，AI 对话会变成"憋一坨再吐"，打字机效果消失
        proxy_buffering     off;
        proxy_cache         off;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        add_header X-Accel-Buffering no;
    }

    # 上传的静态文件（头像等）
    location /uploads/ {
        proxy_pass http://lab_backend;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
