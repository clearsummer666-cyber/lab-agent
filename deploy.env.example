# ============================================================
#  lab-agent 生产部署配置模板
#  用法：cp deploy.env.example deploy.env  然后逐项填真实值
#  说明：deploy.env 已被 .gitignore 的 *.env 规则忽略，不会提交
# ============================================================

# ---------- MySQL ----------
# 密码只用【字母 + 数字】！@ : / ? # 等字符会被拼进连接串，直接连不上库
MYSQL_ROOT_PASSWORD=ChangeMe_UseLettersAndDigitsOnly
MYSQL_DATABASE=lab_agent

# ---------- 站点域名 ----------
# 只写域名，不要 http:// 前缀、不要结尾斜杠
# 部署前务必先在域名服务商把 A 记录解析到服务器公网 IP
SERVER_NAME=lab.yourdomain.com

# 申请 Let's Encrypt 证书用的邮箱（证书快过期时会发提醒）
CERTBOT_EMAIL=you@example.com

# ---------- JWT 签名密钥 ----------
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=please_replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 大模型接口（OpenAI 兼容）----------
LLM_API_KEY=sk-your-real-key
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash
